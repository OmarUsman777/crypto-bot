# Copy to .env for local runs. On Railway, set these as Variables in the dashboard.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional overrides (defaults shown) ---
SYMBOL=PENGU/USDT
TIMEFRAME=5m
PROFIT_TARGET_PCT=1.0
STOP_LOSS_PCT=2.0
MAX_HOLD_MINUTES=0
START_CAPITAL=50
POLL_SECONDS=30
# STATE_FILE=/data/state.json   # set this if you attach a Railway Volume
